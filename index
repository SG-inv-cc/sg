<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Small Giant Inv CC | One Vision • Many Services</title>

<style>

/* =========================================================
   SMALL GIANT INV CC
   MAIN WEBSITE
   EASY EDIT VERSION
   ========================================================= */

/* ---------- BASIC SETTINGS ---------- */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{
    --gold:#ffd21c;
    --gold2:#ffb800;
    --yellow:#ffe45c;
    --black:#050505;
    --dark:#0b0b0b;
    --dark2:#111111;
    --card:#151515;
    --white:#ffffff;
    --gray:#bcbcbc;
    --line:#332900;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#050505;
    color:white;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:inherit;
}

/* ---------- SCROLLBAR ---------- */

::-webkit-scrollbar{
    width:9px;
}

::-webkit-scrollbar-track{
    background:#050505;
}

::-webkit-scrollbar-thumb{
    background:var(--gold);
    border-radius:20px;
}

/* ---------- NAVIGATION ---------- */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:78px;
    z-index:1000;
    background:rgba(0,0,0,.94);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--gold);
}

.navbar{
    max-width:1250px;
    height:100%;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-mark{
    width:48px;
    height:48px;
    border-radius:50%;
    border:2px solid var(--gold);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    font-weight:900;
    color:var(--gold);
    box-shadow:0 0 20px rgba(255,210,28,.25);
}

.logo-text{
    line-height:1;
}

.logo-text strong{
    display:block;
    font-size:19px;
    color:var(--gold);
    letter-spacing:1px;
}

.logo-text span{
    display:block;
    font-size:10px;
    color:white;
    letter-spacing:3px;
    margin-top:4px;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:25px;
}

.nav-links a{
    font-size:14px;
    font-weight:bold;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--gold);
}

.nav-btn{
    background:var(--gold);
    color:#000;
    padding:12px 19px;
    border-radius:30px;
    font-weight:bold;
}

.nav-btn:hover{
    background:white !important;
    color:#000 !important;
}

.menu-toggle{
    display:none;
    font-size:28px;
    color:var(--gold);
    cursor:pointer;
}

/* ---------- HERO ---------- */

.hero{
    min-height:100vh;
    padding:150px 7% 90px;
    position:relative;
    overflow:hidden;
    display:flex;
    align-items:center;
    background:
        radial-gradient(circle at 80% 30%,rgba(255,210,28,.15),transparent 30%),
        radial-gradient(circle at 10% 80%,rgba(255,184,0,.08),transparent 30%),
        #050505;
}

.hero::before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(255,210,28,.025) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,210,28,.025) 1px,transparent 1px);
    background-size:50px 50px;
}

.hero-content{
    max-width:1250px;
    margin:auto;
    width:100%;
    position:relative;
    z-index:2;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:50px;
    align-items:center;
}

.badge{
    display:inline-block;
    padding:9px 17px;
    border:1px solid var(--gold);
    color:var(--gold);
    border-radius:30px;
    font-size:12px;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:20px;
}

.hero h1{
    font-size:clamp(48px,7vw,92px);
    line-height:.9;
    text-transform:uppercase;
    font-weight:1000;
    letter-spacing:-4px;
}

.hero h1 span{
    color:var(--gold);
    text-shadow:0 0 25px rgba(255,210,28,.25);
}

.hero h2{
    margin-top:25px;
    color:#eee;
    font-size:21px;
}

.hero p{
    color:#aaa;
    max-width:650px;
    margin-top:18px;
    line-height:1.7;
    font-size:16px;
}

.hero-buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    margin-top:30px;
}

.btn{
    padding:14px 24px;
    border-radius:30px;
    font-weight:bold;
    border:1px solid var(--gold);
    cursor:pointer;
    transition:.3s;
    display:inline-block;
}

.btn-gold{
    background:var(--gold);
    color:#000;
}

.btn-outline{
    background:transparent;
    color:white;
}

.btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 30px rgba(255,210,28,.2);
}

/* HERO VISUAL */

.hero-visual{
    min-height:480px;
    border:1px solid rgba(255,210,28,.5);
    border-radius:30px;
    position:relative;
    overflow:hidden;
    background:
        linear-gradient(145deg,rgba(255,210,28,.14),rgba(0,0,0,.9)),
        #111;
    box-shadow:0 0 50px rgba(255,210,28,.08);
}

.hero-visual::before{
    content:"SG";
    position:absolute;
    font-size:250px;
    font-weight:1000;
    color:rgba(255,210,28,.035);
    top:60px;
    left:50%;
    transform:translateX(-50%);
}

.hero-circle{
    position:absolute;
    width:280px;
    height:280px;
    border:1px solid var(--gold);
    border-radius:50%;
    top:90px;
    left:50%;
    transform:translateX(-50%);
    animation:spin 20s linear infinite;
}

.hero-circle::before,
.hero-circle::after{
    content:"";
    position:absolute;
    inset:25px;
    border:1px dashed rgba(255,210,28,.6);
    border-radius:50%;
}

.hero-center{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
}

.hero-center .big-sg{
    font-size:100px;
    font-weight:1000;
    color:var(--gold);
    line-height:.8;
}

.hero-center p{
    color:white;
    margin:15px 0 0;
    font-weight:bold;
    letter-spacing:3px;
}

.float-card{
    position:absolute;
    background:rgba(10,10,10,.92);
    border:1px solid rgba(255,210,28,.5);
    padding:13px 17px;
    border-radius:14px;
    font-weight:bold;
    color:white;
    box-shadow:0 10px 30px rgba(0,0,0,.5);
}

.float-card span{
    color:var(--gold);
}

.card1{top:35px;left:25px;}
.card2{top:45px;right:25px;}
.card3{bottom:40px;left:30px;}
.card4{bottom:30px;right:25px;}

@keyframes spin{
    from{transform:translateX(-50%) rotate(0deg);}
    to{transform:translateX(-50%) rotate(360deg);}
}

/* ---------- GENERAL ---------- */

section{
    padding:90px 6%;
}

.section-container{
    max-width:1250px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title small{
    color:var(--gold);
    font-weight:bold;
    letter-spacing:3px;
}

.section-title h2{
    font-size:42px;
    margin-top:10px;
}

.section-title h2 span{
    color:var(--gold);
}

.section-title p{
    color:#999;
    max-width:650px;
    margin:15px auto 0;
    line-height:1.6;
}

/* ---------- ABOUT ---------- */

.about{
    background:#080808;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:45px;
    align-items:center;
}

.about-box{
    padding:35px;
    border:1px solid #2d2600;
    border-radius:20px;
    background:linear-gradient(145deg,#141414,#090909);
}

.about-box h3{
    font-size:30px;
    margin-bottom:18px;
}

.about-box h3 span{
    color:var(--gold);
}

.about-box p{
    color:#aaa;
    line-height:1.8;
    margin-bottom:15px;
}

.about-highlight{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
    margin-top:25px;
}

.highlight{
    padding:20px;
    border:1px solid #302900;
    border-radius:15px;
}

.highlight strong{
    display:block;
    color:var(--gold);
    font-size:22px;
    margin-bottom:5px;
}

.highlight span{
    color:#aaa;
    font-size:13px;
}

.about-visual{
    min-height:430px;
    border-radius:25px;
    border:1px solid var(--gold);
    background:
        radial-gradient(circle at 50% 50%,rgba(255,210,28,.2),transparent 35%),
        linear-gradient(145deg,#181818,#050505);
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    overflow:hidden;
}

.about-visual h3{
    font-size:90px;
    color:var(--gold);
    font-weight:1000;
    text-shadow:10px 10px 0 #222;
}

.about-visual p{
    position:absolute;
    bottom:35px;
    letter-spacing:4px;
    color:#fff;
}

/* ---------- SERVICES ---------- */

.services{
    background:#050505;
}

.service-filter{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:40px;
}

.filter-btn{
    background:#111;
    color:#ccc;
    border:1px solid #333;
    padding:10px 18px;
    border-radius:25px;
    cursor:pointer;
    transition:.3s;
}

.filter-btn:hover,
.filter-btn.active{
    background:var(--gold);
    color:#000;
    border-color:var(--gold);
}

.services-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.service-card{
    background:linear-gradient(145deg,#171717,#0b0b0b);
    border:1px solid #343434;
    border-radius:18px;
    padding:25px;
    min-height:260px;
    transition:.35s;
    position:relative;
    overflow:hidden;
}

.service-card::after{
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    background:var(--gold);
    filter:blur(70px);
    opacity:.08;
    right:-30px;
    bottom:-30px;
}

.service-card:hover{
    transform:translateY(-8px);
    border-color:var(--gold);
    box-shadow:0 20px 40px rgba(0,0,0,.5);
}

.service-icon{
    width:60px;
    height:60px;
    border:1px solid var(--gold);
    border-radius:15px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:29px;
    margin-bottom:20px;
}

.service-card h3{
    font-size:20px;
    margin-bottom:9px;
}

.service-card h3 span{
    color:var(--gold);
}

.service-card p{
    color:#999;
    font-size:13px;
    line-height:1.6;
}

.service-card ul{
    list-style:none;
    margin-top:15px;
}

.service-card li{
    color:#bbb;
    font-size:12px;
    margin:7px 0;
}

.service-card li::before{
    content:"✓";
    color:var(--gold);
    margin-right:8px;
}

.service-open{
    display:inline-block;
    margin-top:18px;
    color:var(--gold);
    font-size:13px;
    font-weight:bold;
    cursor:pointer;
}

/* ---------- DIVISION SECTIONS ---------- */

.division{
    background:#090909;
    border-top:1px solid #171717;
}

.division:nth-child(even){
    background:#050505;
}

.division-header{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:30px;
    margin-bottom:35px;
}

.division-header h2{
    font-size:42px;
}

.division-header h2 span{
    color:var(--gold);
}

.division-header p{
    max-width:500px;
    color:#999;
    line-height:1.6;
}

.division-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:25px;
}

.division-main{
    min-height:360px;
    border:1px solid #3b3200;
    border-radius:25px;
    padding:35px;
    background:
        radial-gradient(circle at 80% 20%,rgba(255,210,28,.13),transparent 30%),
        #111;
}

.division-main h3{
    font-size:32px;
    color:var(--gold);
}

.division-main p{
    color:#aaa;
    line-height:1.7;
    margin-top:15px;
    max-width:650px;
}

.product-list{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin-top:25px;
}

.product{
    border:1px solid #2d2d2d;
    padding:15px;
    border-radius:12px;
    background:#0b0b0b;
}

.product strong{
    display:block;
    color:white;
}

.product span{
    color:var(--gold);
    font-size:13px;
}

.division-side{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.side-box{
    border:1px solid #2d2d2d;
    border-radius:20px;
    padding:25px;
    background:#101010;
}

.side-box .icon{
    font-size:35px;
}

.side-box h4{
    margin-top:12px;
    color:var(--gold);
}

.side-box p{
    color:#888;
    font-size:13px;
    line-height:1.5;
    margin-top:8px;
}

/* ---------- GALLERY ---------- */

.gallery{
    background:#080808;
}

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.gallery-item{
    height:230px;
    border:1px solid #302900;
    border-radius:15px;
    background:
        linear-gradient(145deg,rgba(255,210,28,.15),rgba(0,0,0,.8)),
        #151515;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:20px;
    position:relative;
    overflow:hidden;
    transition:.3s;
}

.gallery-item:hover{
    border-color:var(--gold);
    transform:scale(1.02);
}

.gallery-item strong{
    font-size:22px;
    color:var(--gold);
}

.gallery-item small{
    display:block;
    color:#aaa;
    margin-top:7px;
}

/*
