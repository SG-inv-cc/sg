function openModal(service){

    let data =
    serviceData[service];

    if(!data) return;


    document
    .getElementById("modalTitle")
    .innerText =
    data.title;


    document
    .getElementById("modalDescription")
    .innerText =
    data.description;


    let list =
    document
    .getElementById("modalList");

    list.innerHTML = "";


    data.items.forEach(function(item){

        let li =
        document.createElement("li");

        li.innerText = item;

        list.appendChild(li);

    });


    document
    .getElementById("serviceModal")
    .classList
    .add("active");

}


function closeModal(){

    document
    .getElementById("serviceModal")
    .classList
    .remove("active");

}


/* Close modal by clicking outside */

document
.getElementById("serviceModal")
.addEventListener("click",function(e){

    if(e.target === this){

        closeModal();

    }

});


