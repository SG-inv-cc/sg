/* ---------- WHY US ---------- */

.why{
    background:#050505;
}

.why-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.why-card{
    text-align:center;
    padding:30px 20px;
    border:1px solid #292929;
    border-radius:18px;
    background:#101010;
}

.why-card .icon{
    font-size:40px;
    margin-bottom:15px;
}

.why-card h3{
    color:var(--gold);
    margin-bottom:10px;
}

.why-card p{
    color:#888;
    font-size:13px;
    line-height:1.6;
}

/* ---------- CONTACT ---------- */

.contact{
    background:
        radial-gradient(circle at 50% 0%,rgba(255,210,28,.1),transparent 35%),
        #080808;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
}

.contact-box{
    padding:35px;
    border:1px solid #3a3100;
    border-radius:22px;
    background:#101010;
}

.contact-box h3{
    font-size:28px;
    margin-bottom:20px;
}

.contact-box h3 span{
    color:var(--gold);
}

.contact-item{
    display:flex;
    gap:15px;
    align-items:center;
    padding:17px 0;
    border-bottom:1px solid #222;
}

.contact-item:last-child{
    border-bottom:0;
}

.contact-item .icon{
    width:45px;
    height:45px;
    border-radius:50%;
    background:var(--gold);
    color:#000;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}

.contact-item small{
    display:block;
    color:#777;
    margin-bottom:4px;
}

.contact-item strong{
    color:#fff;
}

.contact-form{
    display:grid;
    gap:13px;
}

.contact-form input,
.contact-form textarea,
.contact-form select{
    width:100%;
    background:#080808;
    color:white;
    border:1px solid #333;
    border-radius:10px;
    padding:15px;
    outline:none;
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus{
    border-color:var(--gold);
}

.contact-form textarea{
    min-height:130px;
    resize:vertical;
}

/* ---------- FOOTER ---------- */

footer{
    background:#030303;
    border-top:1px solid var(--gold);
    padding:50px 6% 25px;
}

.footer-grid{
    max-width:1250px;
    margin:auto;
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr 1fr;
    gap:40px;
}

footer h3{
    color:var(--gold);
    margin-bottom:17px;
}

footer p,
footer li{
    color:#777;
    font-size:13px;
    line-height:1.8;
}

footer ul{
    list-style:none;
}

footer li:hover{
    color:var(--gold);
    cursor:pointer;
}

.socials{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.social{
    width:38px;
    height:38px;
    border:1px solid var(--gold);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold);
    font-weight:bold;
}

.footer-bottom{
    max-width:1250px;
    margin:40px auto 0;
    padding-top:20px;
    border-top:1px solid #1d1d1d;
    text-align:center;
    color:#555;
    font-size:12px;
}

/* ---------- FLOATING WHATSAPP ---------- */

.whatsapp{
    position:fixed;
    right:25px;
    bottom:25px;
    width:60px;
    height:60px;
    border-radius:50%;
    background:#25D366;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    z-index:900;
    box-shadow:0 10px 30px rgba(0,0,0,.5);
    animation:pulse 2s infinite;
}

@keyframes pulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.08);}
}

/* ---------- MODAL ---------- */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.85);
    backdrop-filter:blur(10px);
    z-index:2000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-content{
    width:min(700px,100%);
    max-height:90vh;
    overflow-y:auto;
    background:#111;
    border:1px solid var(--gold);
    border-radius:25px;
    padding:35px;
    position:relative;
}

.close{
    position:absolute;
    right:20px;
    top:15px;
    font-size:30px;
    color:var(--gold);
    cursor:pointer;
}

.modal-content h2{
    color:var(--gold);
    font-size:32px;
    margin-bottom:12px;
}

.modal-content p{
    color:#aaa;
    line-height:1.7;
}

.modal-list{
    margin-top:20px;
    list-style:none;
}

.modal-list li{
    padding:10px;
    border-bottom:1px solid #252525;
    color:#ccc;
}

.modal-list li::before{
    content:"✓ ";
    color:var(--gold);
}

/* ---------- SEARCH ---------- */

.search-box{
    max-width:600px;
    margin:0 auto 30px;
    position:relative;
}

.search-box input{
    width:100%;
    background:#111;
    color:white;
    border:1px solid #333;
    border-radius:30px;
    padding:16px 20px;
    outline:none;
}

.search-box input:focus{
    border-color:var(--gold);
}

/* ---------- RESPONSIVE ---------- */

@media(max-width:1000px){

    .services-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .gallery-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .why-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero-grid,
    .about-grid,
    .division-grid,
    .contact-grid{
        grid-template-columns:1fr;
    }

    .hero-visual{
        min-height:400px;
    }

    .footer-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:750px){

    header{
        height:70px;
    }

    .nav-links{
        position:absolute;
        top:70px;
        left:0;
        width:100%;
        background:#080808;
        display:none;
        flex-direction:column;
        align-items:stretch;
        padding:20px;
        border-bottom:1px solid var(--gold);
    }

    .nav-links.active{
        display:flex;
    }

    .nav-links a{
        padding:13px;
        border-bottom:1px solid #222;
    }

    .menu-toggle{
        display:block;
    }

    .nav-btn{
        text-align:center;
    }

    .hero{
        padding:120px 6% 70px;
    }

    .hero h1{
        font-size:55px;
    }

    .services-grid{
        grid-template-columns:1fr;
    }

    .gallery-grid{
        grid-template-columns:1fr;
    }

